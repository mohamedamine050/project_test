# .env.exmple — variables d'environnement pour le projet Data Engineering
# Ne pas mettre de secrets réels ici. Utilisez un secret manager ou CI secrets.

# ---------- AWS / Auth ----------



# ---------- S3 (buckets générés par Terraform - insérer si connu) ----------
S3_SCRIPTS_BUCKET=<REPLACE_WITH_S3_SCRIPTS_BUCKET>
S3_OUTPUT_BUCKET=<REPLACE_WITH_S3_OUTPUT_BUCKET>

# ---------- Glue jobs (noms / ARN) ----------
# Liste complète des Glue jobs définis dans Terraform. Remplacez par noms ou ARNs.
GLUE_JOB_ETL=<REPLACE_WITH_GLUE_JOB_ETL_NAME_OR_ARN>
GLUE_JOB_ETL_SECOND=<REPLACE_WITH_GLUE_JOB_ETL_SECOND_NAME_OR_ARN>
GLUE_JOB_ETL_THIRD=<REPLACE_WITH_GLUE_JOB_ETL_THIRD_NAME_OR_ARN>
GLUE_JOB_ETL_FOURTH=<REPLACE_WITH_GLUE_JOB_ETL_FOURTH_NAME_OR_ARN>
GLUE_JOB_ETL_FIFTH=<REPLACE_WITH_GLUE_JOB_ETL_FIFTH_NAME_OR_ARN>
GLUE_JOB_ETL_SIXTH=<REPLACE_WITH_GLUE_JOB_ETL_SIXTH_NAME_OR_ARN>
GLUE_JOB_ETL_SEVENTH=<REPLACE_WITH_GLUE_JOB_ETL_SEVENTH_NAME_OR_ARN>
GLUE_JOB_ETL_EIGHTH=<REPLACE_WITH_GLUE_JOB_ETL_EIGHTH_NAME_OR_ARN>
GLUE_JOB_ETL_NINTH=<REPLACE_WITH_GLUE_JOB_ETL_NINTH_NAME_OR_ARN>
GLUE_JOB_ETL_TENTH=<REPLACE_WITH_GLUE_JOB_ETL_TENTH_NAME_OR_ARN>
GLUE_JOB_ETL_ELEVENTH=<REPLACE_WITH_GLUE_JOB_ETL_ELEVENTH_NAME_OR_ARN>
GLUE_JOB_ETL_TWELFTH=<REPLACE_WITH_GLUE_JOB_ETL_TWELFTH_NAME_OR_ARN>


# ---------- RDS / Base de données (connection) ----------
# Ces valeurs seront disponibles après déploiement (outputs) — conserver dans secrets.
RDS_HOST=<REPLACE_WITH_RDS_HOST>
RDS_PORT=<REPLACE_WITH_RDS_PORT>
RDS_DB_NAME=<REPLACE_WITH_RDS_DB_NAME>
RDS_USERNAME=<REPLACE_WITH_RDS_USERNAME>
RDS_PASSWORD=<REPLACE_WITH_RDS_PASSWORD>
RDS_ENGINE=<REPLACE_WITH_RDS_ENGINE>
RDS_ENGINE_VERSION=<REPLACE_WITH_RDS_ENGINE_VERSION>
RDS_INSTANCE_CLASS=<REPLACE_WITH_RDS_INSTANCE_CLASS>
RDS_ALLOCATED_STORAGE=<REPLACE_WITH_RDS_ALLOCATED_STORAGE>
RDS_BACKUP_RETENTION_DAYS=<REPLACE_WITH_RDS_BACKUP_RETENTION_DAYS>


